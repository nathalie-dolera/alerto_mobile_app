{
  "expo": {
    "name": "alerto_frontend_mobile",
    "slug": "alerto_frontend_mobile",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "alertoapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alerto.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app requires your location to find the nearest places and set your destination.",
        "NSBluetoothAlwaysUsageDescription": "Allow Alerto to connect to your wearable device for alarm settings.",
        "NSBluetoothPeripheralUsageDescription": "Allow Alerto to connect to your wearable device for alarm settings.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Allow Alerto to access your camera for driver drowsiness tracking."
      }
    },
    "android": {
      "package": "com.alerto.mobile",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_ADVERTISE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/alerto_logo1.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-secure-store",
      [
        "@maplibre/maplibre-react-native",
        {
          "android": {
            "blockAllRequest": false
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysPermission": "Allow Alerto to monitor your commute for the alarm."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Alerto to access your photos for booking verification.",
          "cameraPermission": "Allow Alerto to take photos of your booking screenshot."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Alerto to access your camera for driver drowsiness tracking.",
          "microphonePermission": "Allow Alerto to access your microphone."
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Allow Alerto to access your camera for driver drowsiness tracking.",
          "enableMicrophonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5aa7b923-aab4-474c-b3df-adc6322ef5ce"
      }
    }
  }
}
