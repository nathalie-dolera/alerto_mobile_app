{
  "expo": {
    "name": "ALERTO",
    "slug": "alerto_frontend_mobile",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "alertoapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alerto.mobile",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Allow Alerto to connect to your wearable device for alarm settings.",
        "NSBluetoothPeripheralUsageDescription": "Allow Alerto to connect to your wearable device for alarm settings.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Allow Alerto to access your camera for driver drowsiness tracking."
      }
    },
    "android": {
      "package": "com.alerto.mobile",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_ADVERTISE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/final_logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.415846957478-705gd7eqakn5esp88b0ltl6hes2snf24"
        }
      ],
      "expo-secure-store",
      [
        "@maplibre/maplibre-react-native",
        {
          "android": {
            "blockAllRequest": false
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysPermission": "Allow Alerto to monitor your commute for the alarm."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Alerto to access your photos for booking verification.",
          "cameraPermission": "Allow Alerto to take photos of your booking screenshot."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Alerto to access your photos to automatically detect recent booking screenshots.",
          "savePhotosPermission": "Allow Alerto to save photos."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Alerto to access your camera for driver drowsiness tracking.",
          "microphonePermission": "Allow Alerto to access your microphone."
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Allow Alerto to access your camera for driver drowsiness tracking.",
          "enableMicrophonePermission": false
        }
      ],
      "react-native-ble-plx",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3e69faf1-cee0-4ae7-9a0d-1544a48bbe4b"
      }
    },
    "owner": "alerto_8"
  }
}
